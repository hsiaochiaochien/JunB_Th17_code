#!/usr/bin/Rscript
#in Th17beta cell
setwd("/Users/chien/Library/CloudStorage/OneDrive-OIST/data/00_All_data_and_script_for_manuscript/03_figure2_atacseq_invitro/Figure2e/data")
#generate data for DESeq2
tag_file_annotated <- read.table("ATACseq_naive_pTh17_only_Th17beta_Th1723_annotated_given_tag_for_R.txt",sep="\t",quote = "")
title <- c("Row.names","Chr","Start","End","Gene Name","Annotation","Distance_to_nearest_RefSeq_TSS","Th17-beta-CD4-JunB-WT1","Th17-beta-CD4-JunB-WT2","Th17-beta-CD4-JunB-KO1","Th17-beta-CD4-JunB-KO2","Th17-23-CD4-JunB-WT1","Th17-23-CD4-JunB-WT2","Th17-23-CD4-JunB-KO1","Th17-23-CD4-JunB-KO2")
names(tag_file_annotated)[1:15] <- title
sampleNames <- c("Th17-beta-CD4-JunB-WT1","Th17-beta-CD4-JunB-WT2","Th17-beta-CD4-JunB-KO1","Th17-beta-CD4-JunB-KO2")
countData <- as.matrix(tag_file_annotated[8:11])
mode(countData) <- "integer"
rownames(countData) <- tag_file_annotated$Row.names
database <- data.frame(name=sampleNames,condition=c("WT", "WT","KO","KO"))
rownames(database) <- sampleNames
rm (sampleNames)
#==========================================================================================================================================================================================================================================
#in Th1723 cell
setwd("/Users/chien/Library/CloudStorage/OneDrive-OIST/data/00_All_data_and_script_for_manuscript/03_figure2_atacseq_invitro/Figure2e/data")
#generate data for DESeq2
tag_file_annotated <- read.table("ATACseq_naive_pTh17_only_Th17beta_Th1723_annotated_given_tag_for_R.txt",sep="\t",quote = "")
title <- c("Row.names","Chr","Start","End","Gene Name","Annotation","Distance_to_nearest_RefSeq_TSS","Th17-beta-CD4-JunB-WT1","Th17-beta-CD4-JunB-WT2","Th17-beta-CD4-JunB-KO1","Th17-beta-CD4-JunB-KO2","Th17-23-CD4-JunB-WT1","Th17-23-CD4-JunB-WT2","Th17-23-CD4-JunB-KO1","Th17-23-CD4-JunB-KO2")
names(tag_file_annotated)[1:15] <- title
sampleNames <- c("Th17-23-CD4-JunB-WT1","Th17-23-CD4-JunB-WT2","Th17-23-CD4-JunB-KO1","Th17-23-CD4-JunB-KO2")
#countData <- as.matrix(tag_file_annotated[8:11])
countData <- as.matrix(tag_file_annotated[12:15])
mode(countData) <- "integer"
rownames(countData) <- tag_file_annotated$Row.names
database <- data.frame(name=sampleNames,condition=c("WT", "WT","KO","KO"))
rownames(database) <- sampleNames
rm (sampleNames)
#run DESeq2
library(DESeq2)
dds <- DESeqDataSetFromMatrix(countData, colData=database, design= ~ condition)
dds <- dds[ rowSums(counts(dds)) > 1, ]
dds <- DESeq(dds)
res <- results(dds,contrast=c("condition","KO","WT"))
resdata <- merge(as.data.frame(res), as.data.frame(counts(dds, normalized=TRUE)),by="row.names",sort=FALSE)
#assing 1 to p value or FDR
resdata[["padj"]][is.na(resdata[["padj"]])] <- 1
resdata[["pvalue"]][is.na(resdata[["pvalue"]])] <- 1
rm(countData)
rm(database)
#rm(dds)
rm(res)
onlyname <-subset(tag_file_annotated,select=c("Row.names","Chr","Start","End","Gene Name","Annotation","Distance_to_nearest_RefSeq_TSS"))
finaltable <- merge(resdata,onlyname,by="Row.names",sort=FALSE)
rm(tag_file_annotated)
rm(onlyname)
rm(resdata)
finaltable$WT_mean <- rowMeans(finaltable[,c('Th17-23-CD4-JunB-WT1','Th17-23-CD4-JunB-WT2')], na.rm=TRUE)
finaltable$KO_mean <- rowMeans(finaltable[,c("Th17-23-CD4-JunB-KO1","Th17-23-CD4-JunB-KO2")], na.rm=TRUE)
finaltable$WT_mean_log2 <- log(finaltable[,c('WT_mean')], 2)
finaltable$KO_mean_log2 <- log(finaltable[,c('KO_mean')], 2)
#==============================================================================================
#FDR<0.05,log2FC1
#add color by using tag only data
finaltable$color <- ifelse(finaltable$padj < 0.05 & abs(finaltable$log2FoldChange) >= 1,ifelse(finaltable$log2FoldChange > 1 ,'red','blue'),'gray')
#count the log2FC
library(dplyr)
df_ko <- dplyr::filter(finaltable, padj < 0.05 & log2FoldChange > 1)
df_wt <- dplyr::filter(finaltable, padj < 0.05 & log2FoldChange < -1)
paste("ko=",nrow(df_ko))
paste("wt=",nrow(df_wt))
#==============================================================================================
#FDR<0.05,log2FC1
#add color by using tag only data
finaltable$color <- ifelse(finaltable$padj < 0.05 & abs(finaltable$log2FoldChange) >= 1,ifelse(finaltable$log2FoldChange > 1 ,'red','blue'),'gray')
#count the log2FC
library(dplyr)
df_ko <- dplyr::filter(finaltable, padj < 0.05 & log2FoldChange > 1)
df_wt <- dplyr::filter(finaltable, padj < 0.05 & log2FoldChange < -1)
paste("ko=",nrow(df_ko))
paste("wt=",nrow(df_wt))
df <- dplyr::filter(finaltable, padj < 0.05 & abs(log2FoldChange) > 1)
color<- c(red = "red", gray = "gray", blue ="blue")
library(ggplot2)
p <- ggplot(finaltable, aes(WT_mean_log2, KO_mean_log2, col= color)) +
geom_point(size = 0.8) +
theme_bw() +
scale_color_manual(values = color) +
labs(x="WT tags (log2)",y="JunB-KO tags (log2)")+
ggtitle("npTh17 only_JunB effect in pTh17") +
theme(plot.title = element_text(hjust = 0.5),
legend.position = "none",
panel.grid=element_blank(),
axis.title = element_text(size = 16),
axis.text = element_text(size = 14))+
annotate("text", x=Inf,y=Inf, hjust=1,vjust=1,label = nrow(finaltable)-nrow(df_wt)-nrow(df_ko),size= 8,,col= "gray"  )+
scale_x_continuous(limits = c(0, 12), breaks = seq(0, 12, by = 4))+
scale_y_continuous(limits = c(0, 12), breaks = seq(0, 12, by = 4))+
annotate("text", x=Inf,y=-Inf, hjust=1,vjust=0,label =nrow(df_wt),size= 8,col= "blue" )+
annotate("text", x=-Inf,y=Inf, hjust=0,vjust=1,label =nrow(df_ko),size= 8,col= "red")
p
knitr::opts_chunk$set(echo = TRUE)
# Directory containing the files
dir <- "/Users/chien/Library/CloudStorage/OneDrive-OIST/data/00_All_data_and_script_for_manuscript/06_figure5_Chiseq_BATF_SRG3_MLL/Figure5a_5b_Rscript/data"
# Output directory for plots
output_dir <- "/Users/chien/Library/CloudStorage/OneDrive-OIST/data/00_All_data_and_script_for_manuscript/06_figure5_Chiseq_BATF_SRG3_MLL/Figure5a_5b_Rscript/plot"
# List of files to process
files <- c(
"matrix_ATAC_bed_log2FCmore1_FDR0.05_BRG1.txt",
"matrix_ATAC_bed_log2FCmore1_FDR0.05_SRG3.txt",
"matrix_ATAC_bed_log2FCmore1_FDR0.05_MLL4.txt",
"matrix_ATAC_bed_log2FCmore1_FDR0.05_WDR5.txt"
)
process_file <- function(filename, dir, output_dir) {
cat("Processing:", filename, "\n")
original_df <- read.table(
file.path(dir, filename),
sep = "\t",
quote = "",
header = TRUE,
check.names = FALSE
)
cat("Dimension:", dim(original_df), "\n")
bins_per_sample <- 1000
means_list <- lapply(
seq(1, ncol(original_df), by = bins_per_sample),
function(start_col) {
end_col <- start_col + bins_per_sample - 1
colMeans(
original_df[, start_col:end_col, drop = FALSE],
na.rm = TRUE
)
}
)
mean_df <- as.data.frame(do.call(cbind, means_list))
colnames(mean_df) <- c(
"wt1", "wt2", "wt3",
"ko1", "ko2", "ko3"
)
avg_df <- data.frame(
WT = rowMeans(mean_df[, c("wt1", "wt2", "wt3")], na.rm = TRUE),
KO = rowMeans(mean_df[, c("ko1", "ko2", "ko3")], na.rm = TRUE)
)
plot_title <- gsub(
"matrix_ATAC_bed_log2FCmore1_FDR0.05_",
"",
filename
)
plot_title <- gsub("\\.txt$", "", plot_title)
plot_file <- file.path(
output_dir,
paste0(
"plot_ATAC_bed_log2FCmore1_FDR0.05_",
plot_title,
"_profile.png"
)
)
dir.create(
output_dir,
recursive = TRUE,
showWarnings = FALSE
)
png(
plot_file,
width = 1200,
height = 1000,
res = 300
)
par(mar = c(5, 5, 3, 2))
matplot(
x = 1:nrow(avg_df),
y = avg_df,
type = "l",
lwd = 3,
lty = 1,
col = c("blue", "red"),
xaxt = "n",
xlab = "",
ylab = "Mean signal",
main = plot_title,
ylim = range(avg_df, na.rm = TRUE)
)
axis(
1,
at = c(1, 500, 1000),
labels = c("-5 kb", "Center", "+5 kb")
)
legend(
"topright",
legend = c("WT", "KO"),
col = c("blue", "red"),
lwd = 3,
bty = "n"
)
box()
dev.off()
cat("Saved:", plot_file, "\n\n")
}
for (file in files) {
process_file(file, dir, output_dir)
}
setwd("/Users/chien/Library/CloudStorage/OneDrive-OIST/data/00_All_data_and_script_for_manuscript/06_figure6/figure6e/Rscript/data")
tpm <-read.table("salmon.merged.gene_tpm.txt",header =T)
# only select 6 to 72 hr no restimulate
tpm <- tpm[, c(2,9:(ncol(tpm)-6))]
tpm <-tpm[rowSums(tpm[ , c(2:ncol(tpm))])>0,]
#-----------------------------------------------------------------------
#plot RNAseq time serious
for (gene in c("Nfkb1","Nfkb2","Nr4a1","Nr4a2","Nr4a3","Runx1","Runx2","Runx3","Ets1","Ets2")) {
subgene <-tpm[grepl(gene,tpm$gene_name),2:ncol(tpm)]
subgene <-subgene[1,1:ncol(subgene)]
#if there are two sample using subgene[2,1:ncol(subgene)]
rownames(subgene) <- "tpm"
df<- data.frame(genotype = rep(rep(c("WT", "KO"), each=3),times =6),
time = rep(c("06hr","12hr","24hr","36hr","48hr","72hr"), each=6),
t(subgene[,1:ncol(subgene)]))
df$genotype <- factor(df$genotype, levels = c("WT", "KO"))
library(ggplot2)
p<-ggplot(df, aes(x=time, y=tpm, group=genotype)) +
geom_point(size=2,aes(shape=genotype))+
scale_shape_manual(values = c(16, 1)) +
theme_classic()+
geom_smooth(aes(x=time, y=tpm, color = genotype, fill=genotype)) +
labs(title = gene, x = "time", y = "TPM")+
theme(plot.title = element_text(hjust = 0.5,size=20))+
scale_color_manual(values=c("blue", "red"))+
scale_fill_manual(values=c("blue", "red"))
p
savedir_png <- "/Users/chien/Library/CloudStorage/OneDrive-OIST/data/00_All_data_and_script_for_manuscript/06_figure6/figure6e/Rscript/plot"
ggsave(file.path(savedir_png,paste0(gene,"_RNAseq_time_serious_tpm",".png",sep="")),dpi = 300,width = 8,height = 5)
}
